[
    {
        "id": "tab_driver_dashboard",
        "type": "tab",
        "label": "Driver Safety Dashboard",
        "disabled": false,
        "info": "Production dashboard for ESP32 Driver Behaviour Analysis System."
    },
    {
        "id": "ui_tab_main",
        "type": "ui_tab",
        "name": "Fleet Overview",
        "icon": "dashboard", "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "group_controls",
        "type": "ui_group",
        "name": "Device Selection & System Status",
        "tab": "ui_tab_main",
        "order": 1,
        "width": "6",
        "disp": true,
        "width": 6
    },
    {
        "id": "group_score",
        "type": "ui_group",
        "name": "Driver Safety Score",
        "tab": "ui_tab_main",
        "order": 2,
        "width": "6",
        "disp": true,
        "width": 6
    },
    {
        "id": "group_telemetry",
        "type": "ui_group",
        "name": "Live Vehicle Telemetry",
        "tab": "ui_tab_main",
        "order": 3,
        "width": "12",
        "disp": true,
        "width": 12
    },
    {
        "id": "group_alerts",
        "type": "ui_group",
        "name": "Real-Time Alerts & Feed",
        "tab": "ui_tab_main",
        "order": 4,
        "width": "12",
        "disp": true,
        "width": 12
    },
    {
        "id": "mqtt_broker_config",
        "type": "mqtt-broker",
        "name": "Local MQTT Broker",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered_dashboard_client",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "node_driver_dropdown",
        "type": "ui_dropdown",
        "z": "tab_driver_dashboard",
        "name": "Select Device",
        "label": "Active Device ID",
        "tooltip": "Choose a fleet device to inspect telemetry and scores. Replace these placeholder values with real device IDs - the firmware derives each device_id from its ESP32's factory MAC address (12 uppercase hex chars, see mqtt_client.c's mqtt_generate_device_id()), it is not user-assigned.",
        "group": "group_controls",
        "order": 1,
        "width": 6,
        "height": 1,
        "passthru": true,
        "multiple": false,
        "options": [
            { "label": "Device 001 (replace with real MAC-derived ID)", "value": "AABBCCDDEEFF", "type": "str" },
            { "label": "Device 002 (replace with real MAC-derived ID)", "value": "112233445566", "type": "str" },
            { "label": "Device 003 (replace with real MAC-derived ID)", "value": "AA11BB22CC33", "type": "str" }
        ],
        "payload": "",
        "topic": "device_id",
        "topicType": "msg",
        "x": 150,
        "y": 100,
        "wires": [["node_set_driver_context"]]
    },
    {
        "id": "node_set_driver_context",
        "type": "function",
        "z": "tab_driver_dashboard",
        "name": "Store Device in Context",
        "func": "flow.set('selected_device', msg.payload);\nnode.status({fill: 'green', shape: 'dot', text: 'Active: ' + msg.payload});\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [["node_trigger_score_fetch", "node_trigger_alerts_fetch"]]
    },
    {
        "id": "node_mqtt_telemetry_in",
        "type": "mqtt in",
        "z": "tab_driver_dashboard",
        "name": "MQTT Telemetry Subscriber",
        "topic": "fleet/+/telemetry",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 200,
        "wires": [["node_parse_telemetry"]]
    },
    {
        "id": "node_parse_telemetry",
        "type": "function",
        "z": "tab_driver_dashboard",
        "name": "Filter Telemetry by Device",
        "func": "// Topic shape is \"fleet/{device_id}/telemetry\" (see config.h's\n// MQTT_TOPIC_TELEMETRY_FMT), so splitting on \"/\" gives\n// [\"fleet\", device_id, \"telemetry\"] - device_id is index 1, not 2.\nvar selectedDevice = flow.get('selected_device') || 'AABBCCDDEEFF';\nvar topicParts = msg.topic.split('/');\nvar deviceIdFromTopic = topicParts[1];\n\nif (deviceIdFromTopic === selectedDevice || selectedDevice === 'ALL') {\n    // Field names must match the firmware's actual telemetry JSON\n    // (task_manager.c's task_manager_telemetry_task()): the firmware\n    // publishes obd_speed_kmh / gps_speed_kmh and accel_x_g/y/z, never\n    // \"speed_kmh\" or \"ax\"/\"ay\"/\"az\".\n    var speed = msg.payload.obd_speed_valid\n        ? msg.payload.obd_speed_kmh\n        : (msg.payload.gps_speed_kmh || 0);\n    var ax = msg.payload.accel_x_g || 0;\n    var ay = msg.payload.accel_y_g || 0;\n    var az = msg.payload.accel_z_g || 0;\n\n    return [\n        { payload: speed },\n        { payload: ax, topic: 'Ax' },\n        { payload: ay, topic: 'Ay' },\n        { payload: az, topic: 'Az' }\n    ];\n}\nreturn null;",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 200,
        "wires": [
            ["node_gauge_speed"],
            ["node_chart_accel"],
            ["node_chart_accel"],
            ["node_chart_accel"]
        ]
    },
    {
        "id": "node_gauge_speed",
        "type": "ui_gauge",
        "z": "tab_driver_dashboard",
        "name": "Speed Gauge",
        "group": "group_telemetry",
        "order": 1,
        "width": 4,
        "height": 4,
        "gtype": "gage",
        "title": "Speed (km/h)",
        "label": "km/h",
        "format": "{{value | number:1}}",
        "min": 0,
        "max": 180,
        "colors": ["#00b500", "#e6e600", "#ca0101"],
        "seg1": "80",
        "seg2": "120",
        "className": "",
        "x": 670,
        "y": 180,
        "wires": []
    },
    {
        "id": "node_chart_accel",
        "type": "ui_chart",
        "z": "tab_driver_dashboard",
        "name": "3-Axis Acceleration",
        "group": "group_telemetry",
        "order": 2,
        "width": 8,
        "height": 4,
        "label": "Acceleration Force (g)",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "Awaiting Telemetry Stream...",
        "dot": false,
        "ymin": "-4",
        "ymax": "4",
        "removeOlder": "1",
        "removeOlderPoints": "100",
        "removeOlderUnit": "60",
        "cutout": 0,
        "useOneColor": false,
        "useUTC": false,
        "colors": ["#1f77b4", "#aec7e8", "#ff7f0e"],
        "outputs": 1,
        "className": "",
        "x": 690,
        "y": 240,
        "wires": [[]]
    },
    {
        "id": "node_poll_timer",
        "type": "inject",
        "z": "tab_driver_dashboard",
        "name": "10s Poll Timer",
        "props": [{ "p": "payload" }],
        "repeat": "10",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "tick",
        "payloadType": "str",
        "x": 130,
        "y": 320,
        "wires": [["node_trigger_score_fetch", "node_trigger_alerts_fetch"]]
    },
    {
        "id": "node_trigger_score_fetch",
        "type": "function",
        "z": "tab_driver_dashboard",
        "name": "Build Score API Request",
        "func": "var deviceId = flow.get('selected_device') || 'AABBCCDDEEFF';\n// GET /devices/{device_id}/score returns the single most recent score\n// record (see backend/api.py); there is no bare /drivers/.../score\n// route in the backend, and drivers/ was never the right resource\n// name since the schema is device-keyed, not driver-keyed.\nmsg.url = 'http://localhost:8000/api/v1/devices/' + deviceId + '/score';\nmsg.method = 'GET';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 300,
        "wires": [["node_http_get_score"]]
    },
    {
        "id": "node_http_get_score",
        "type": "http request",
        "z": "tab_driver_dashboard",
        "name": "GET /devices/{id}/score",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 610,
        "y": 300,
        "wires": [["node_parse_score_response"]]
    },
    {
        "id": "node_parse_score_response",
        "type": "function",
        "z": "tab_driver_dashboard",
        "name": "Format Safety Score",
        "func": "// Backend's ScoreOut model returns \"score\" and a derived \"rating\"\n// field directly (see backend/api.py's ScoreOut.rating_for()) -\n// there is no \"safety_score\" field anywhere in this pipeline.\nif (msg.statusCode === 200 && msg.payload && msg.payload.score !== undefined) {\n    var score = msg.payload.score;\n    var rating = msg.payload.rating || 'N/A';\n    return [\n        { payload: score },\n        { payload: 'Rating: ' + rating }\n    ];\n}\nreturn [null, { payload: 'Score Unavailable' }];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 300,
        "wires": [
            ["node_gauge_score"],
            ["node_text_rating"]
        ]
    },
    {
        "id": "node_gauge_score",
        "type": "ui_gauge",
        "z": "tab_driver_dashboard",
        "name": "Safety Score Gauge",
        "group": "group_score",
        "order": 1,
        "width": 6,
        "height": 3,
        "gtype": "donut",
        "title": "Safety Score (0-100)",
        "label": "Score",
        "format": "{{value}}",
        "min": 0,
        "max": 100,
        "colors": ["#ca0101", "#e6e600", "#00b500"],
        "seg1": "50",
        "seg2": "80",
        "className": "",
        "x": 1070,
        "y": 280,
        "wires": []
    },
    {
        "id": "node_text_rating",
        "type": "ui_text",
        "z": "tab_driver_dashboard",
        "name": "Driver Rating Label",
        "group": "group_score",
        "order": 2,
        "width": 6,
        "height": 1,
        "label": "Classification:",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 1070,
        "y": 320,
        "wires": []
    },
    {
        "id": "node_trigger_alerts_fetch",
        "type": "function",
        "z": "tab_driver_dashboard",
        "name": "Build Alerts API Request",
        "func": "var deviceId = flow.get('selected_device') || 'AABBCCDDEEFF';\n// GET /devices/{device_id}/alerts (backend/api.py); the old\n// /drivers/{id}/alerts route never existed in the backend.\nmsg.url = 'http://localhost:8000/api/v1/devices/' + deviceId + '/alerts?limit=10';\nmsg.method = 'GET';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 360,
        "wires": [["node_http_get_alerts"]]
    },
    {
        "id": "node_http_get_alerts",
        "type": "http request",
        "z": "tab_driver_dashboard",
        "name": "GET /devices/{id}/alerts",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 610,
        "y": 360,
        "wires": [["node_format_alerts_table"]]
    },
    {
        "id": "node_format_alerts_table",
        "type": "function",
        "z": "tab_driver_dashboard",
        "name": "Format Alerts Table",
        "func": "// AlertOut (backend/api.py) has: timestamp_ms, alert_type,\n// latitude_deg, longitude_deg, raw_payload_json. There is no\n// \"severity\" or \"message\" field anywhere in the alert schema (the\n// firmware only ever publishes \"excessive_idling\" and\n// \"geofence_violation\" alert types, both without a severity concept),\n// so this now surfaces the fields that actually exist instead of\n// silently rendering blank columns.\nif (msg.statusCode === 200 && Array.isArray(msg.payload)) {\n    var tableData = msg.payload.map(function(item) {\n        var ts = item.timestamp_ms ? new Date(item.timestamp_ms).toLocaleString() : 'N/A';\n        var location = (item.latitude_deg !== null && item.latitude_deg !== undefined)\n            ? item.latitude_deg.toFixed(4) + ', ' + item.longitude_deg.toFixed(4)\n            : 'N/A';\n        return {\n            \"Timestamp\": ts,\n            \"Alert Type\": item.alert_type || 'unknown',\n            \"Location\": location,\n            \"Details\": item.raw_payload_json || ''\n        };\n    });\n    msg.payload = tableData;\n    return msg;\n}\nmsg.payload = [];\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 360,
        "wires": [["node_ui_table_alerts"]]
    },
    {
        "id": "node_ui_table_alerts",
        "type": "ui_table",
        "z": "tab_driver_dashboard",
        "name": "Recent Alerts Table",
        "group": "group_alerts",
        "order": 1,
        "width": 12,
        "height": 5,
        "columns": [
            { "vc": "Timestamp", "field": "Timestamp", "title": "Timestamp", "width": "20%" },
            { "vc": "Alert Type", "field": "Alert Type", "title": "Alert Type", "width": "20%" },
            { "vc": "Location", "field": "Location", "title": "Location", "width": "20%" },
            { "vc": "Details", "field": "Details", "title": "Details", "width": "40%" }
        ],
        "outputs": 0,
        "cts": false,
        "className": "",
        "x": 1070,
        "y": 360,
        "wires": []
    },
    {
        "id": "node_mqtt_alerts_in",
        "type": "mqtt in",
        "z": "tab_driver_dashboard",
        "name": "MQTT Real-Time Alert Popups",
        "topic": "fleet/+/alert",
        "qos": "2",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 460,
        "wires": [["node_popup_toast"]]
    },
    {
        "id": "node_popup_toast",
        "type": "ui_toast",
        "z": "tab_driver_dashboard",
        "name": "Alert Notification Toast",
        "position": "top right",
        "displayTime": "5",
        "highlight": "red",
        "sendDismiss": false,
        "topic": "CRITICAL ALERT",
        "outputs": 0,
        "ok": "OK",
        "cancel": "",
        "raw": false,
        "className": "",
        "x": 420,
        "y": 460,
        "wires": []
    }
]
